# PetCare AI Analytics Assistant - configuration template
# Copy to petcare/.env and fill in real values. Never commit .env.

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=petcare_db

# --- LLM ---
# mock: no API key needed (local smoke tests)
# deepseek / openai / anthropic: requires LLM_API_KEY (+ optional LLM_BASE_URL)
# ollama: local model, no key (set LLM_MODEL e.g. qwen2.5:7b)
LLM_PROVIDER=mock
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# --- Data window baseline ---
# All seed/generated dates are derived relative to this date
# (data ends BASE_DATE - 3 months - 1 day)
PETCARE_BASE_DATE=2026-08-01
