# PetCare AI Analytics Assistant - configuration template
# Copy to petcare/.env and fill in real values. Never commit .env.

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=petcare_db

# --- LLM ---
# mock: no API key needed (local smoke tests)
# deepseek / openai / anthropic: requires LLM_API_KEY (+ optional LLM_BASE_URL)
# ollama: local model, no key (set LLM_MODEL e.g. qwen2.5:7b)
LLM_PROVIDER=mock
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# --- Business analysis time reference ---
# All "today / this month / last month / recent 3 months" semantics are
# relative to this date (business data ends on this day)
PETCARE_AS_OF_DATE=2026-04-30
